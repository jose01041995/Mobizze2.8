{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "PT"
        }
      ],
      "destination": "/pt/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "BR"
        }
      ],
      "destination": "/pt/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "AO"
        }
      ],
      "destination": "/pt/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "MZ"
        }
      ],
      "destination": "/pt/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "CV"
        }
      ],
      "destination": "/pt/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "GW"
        }
      ],
      "destination": "/pt/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "ST"
        }
      ],
      "destination": "/pt/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "TL"
        }
      ],
      "destination": "/pt/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "GQ"
        }
      ],
      "destination": "/pt/",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/pt/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/pt/:path*",
      "destination": "/pt/:path*"
    },
    {
      "source": "/en/:path*",
      "destination": "/en/:path*"
    },
    {
      "source": "/:path((?!en|pt|api|_next|favicon|assets|images|css|js).*)",
      "destination": "/pt/:path"
    }
  ],
  "cleanUrls": true
}